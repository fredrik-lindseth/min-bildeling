{
  "manifest_version": 3,
  "name": "Min bildeling",
  "version": "1.0.2",
  "description": "Statistikk over bildelingen din på dele.no",
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://app.dele.no/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.dele.no/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "theme_icons": [
      { "size": 16, "light": "icons/icon-dark-16.png", "dark": "icons/icon-16.png" },
      { "size": 32, "light": "icons/icon-dark-32.png", "dark": "icons/icon-32.png" },
      { "size": 48, "light": "icons/icon-dark-48.png", "dark": "icons/icon-48.png" },
      { "size": 96, "light": "icons/icon-dark-96.png", "dark": "icons/icon-96.png" },
      { "size": 128, "light": "icons/icon-dark-128.png", "dark": "icons/icon-128.png" }
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "delebil@fredriklindseth.no",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
